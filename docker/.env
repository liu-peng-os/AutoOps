# Ports
WEB_PORT=8088
API_PORT=8000
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091

# Public endpoints used by the backend
IMAGE_HOST=http://localhost:8088
SERVER_PUBLIC_URL=http://localhost:8088/

# PostgreSQL
DB_DIALECTS=postgres
# Internal Docker service endpoint.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=autoops
DB_USER=postgres
DB_PASSWORD=postgres123456
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=devops@2025
REDIS_ADDR=redis:6379

# Runtime
TZ=Asia/Shanghai

# dnsmgr integration (disabled by default; fill these on the server)
DNSMGR_ENABLED=false
DNSMGR_BASE_URL=
DNSMGR_UID=
DNSMGR_API_KEY=
